	// one: i % 10 = 1 and i % 100 != 11
	if o.i % 10 == 1 && o.i % 100 != 11 {
		return .One
	}
	// two: i % 10 = 2 and i % 100 != 12
	if o.i % 10 == 2 && o.i % 100 != 12 {
		return .Two
	}
	// few: i % 10 = 3,4 and i % 100 != 13,14
	if (o.i % 10 == 3 || o.i % 10 == 4) && !(o.i % 100 == 13 || o.i % 100 == 14) {
		return .Few
	}
	return .Other
}

// ordinal_bn implements the CLDR ordinal rules for: bn.
@(private = "file")
ordinal_bn :: proc "contextless" (o: Operands) -> Category {
	// one: n = 1,5,7,8,9,10
	if (o.t == 0 && (o.i == 1 || o.i == 5 || o.i == 7 || o.i == 8 || o.i == 9 || o.i == 10)) {
		return .One
	}
	// two: n = 2,3
	if (o.t == 0 && (o.i == 2 || o.i == 3)) {
		return .Two
	}
	// few: n = 4
	if (o.t == 0 && o.i == 4) {
		return .Few
	}
	// many: n = 6
	if (o.t == 0 && o.i == 6) {
		return .Many
	}
	return .Other
}

// ordinal_ca implements the CLDR ordinal rules for: ca.
@(private = "file")
ordinal_ca :: proc "contextless" (o: Operands) -> Category {
	// one: n = 1,3
	if (o.t == 0 && (o.i == 1 || o.i == 3)) {
		return .One
	}
	// two: n = 2
	if (o.t == 0 && o.i == 2) {
		return .Two
	}
	// few: n = 4
	if (o.t == 0 && o.i == 4) {
		return .Few
	}
	return .Other
}

// ordinal_cy implements the CLDR ordinal rules for: cy.
@(private = "file")
ordinal_cy :: proc "contextless" (o: Operands) -> Category {
	// zero: n = 0,7,8,9
	if (o.t == 0 && (o.i == 0 || o.i == 7 || o.i == 8 || o.i == 9)) {
		return .Zero
	}
	// one: n = 1
	if (o.t == 0 && o.i == 1) {
		return .One
	}
	// two: n = 2
	if (o.t == 0 && o.i == 2) {
		return .Two
	}
	// few: n = 3,4
	if (o.t == 0 && (o.i == 3 || o.i == 4)) {
		return .Few
	}
	// many: n = 5,6
	if (o.t == 0 && (o.i == 5 || o.i == 6)) {
		return .Many
	}
	return .Other
}

// ordinal_en implements the CLDR ordinal rules for: en.
@(private = "file")
ordinal_en :: proc "contextless" (o: Operands) -> Category {
	// one: n % 10 = 1 and n % 100 != 11
	if (o.t == 0 && o.i % 10 == 1) && !(o.t == 0 && o.i % 100 == 11) {
		return .One
	}
	// two: n % 10 = 2 and n % 100 != 12
	if (o.t == 0 && o.i % 10 == 2) && !(o.t == 0 && o.i % 100 == 12) {
		return .Two
	}
	// few: n % 10 = 3 and n % 100 != 13
	if (o.t == 0 && o.i % 10 == 3) && !(o.t == 0 && o.i % 100 == 13) {
		return .Few
	}
	return .Other
}

// ordinal_es implements the CLDR ordinal rules for: es.
@(private = "file")
ordinal_es :: proc "contextless" (o: Operands) -> Category {
	// one: n % 10 = 1,3 and n % 100 != 11
	if (o.t == 0 && (o.i % 10 == 1 || o.i % 10 == 3)) && !(o.t == 0 && o.i % 100 == 11) {
		return .One
	}
	return .Other
}

// ordinal_fil implements the CLDR ordinal rules for: fil fr ga hy lo ms ro tl vi.
@(private = "file")
ordinal_fil :: proc "contextless" (o: Operands) -> Category {
	// one: n = 1
	if (o.t == 0 && o.i == 1) {
		return .One
	}
	return .Other
}

// ordinal_gu implements the CLDR ordinal rules for: gu hi.
@(private = "file")
ordinal_gu :: proc "contextless" (o: Operands) -> Category {
	// one: n = 1
	if (o.t == 0 && o.i == 1) {
		return .One
	}
	// two: n = 2,3
	if (o.t == 0 && (o.i == 2 || o.i == 3)) {
		return .Two
	}
	// few: n = 4
	if (o.t == 0 && o.i == 4) {
		return .Few
	}
	// many: n = 6
	if (o.t == 0 && o.i == 6) {
		return .Many
	}
	return .Other
}

// ordinal_hu implements the CLDR ordinal rules for: hu.
@(private = "file")
ordinal_hu :: proc "contextless" (o: Operands) -> Category {
	// one: n = 1,5
	if (o.t == 0 && (o.i == 1 || o.i == 5)) {
		return .One
	}
	return .Other
}

// ordinal_it implements the CLDR ordinal rules for: it.
@(private = "file")
ordinal_it :: proc "contextless" (o: Operands) -> Category {
	// many: n = 11,8,80,800
	if (o.t == 0 && (o.i == 11 || o.i == 8 || o.i == 80 || o.i == 800)) {
		return .Many
	}
	return .Other
}

// ordinal_ka implements the CLDR ordinal rules for: ka.
@(private = "file")
ordinal_ka :: proc "contextless" (o: Operands) -> Category {
	// one: i = 1
	if o.i == 1 {
		return .One
	}
	// many: i = 0 or i % 100 = 2..20,40,60,80
	if o.i == 0 || (between(o.i % 100, 2, 20) || o.i % 100 == 40 || o.i % 100 == 60 || o.i % 100 == 80) {
		return .Many
	}
	return .Other
}

// ordinal_kk implements the CLDR ordinal rules for: kk.
@(private = "file")
ordinal_kk :: proc "contextless" (o: Operands) -> Category {
	// many: n % 10 = 6 or n % 10 = 9 or n % 10 = 0 and n != 0
	if (o.t == 0 && o.i % 10 == 6) || (o.t == 0 && o.i % 10 == 9) || (o.t == 0 && o.i % 10 == 0) && !(o.t == 0 && o.i == 0) {
		return .Many
	}
	return .Other
}

// ordinal_mk implements the CLDR ordinal rules for: mk.
@(private = "file")
ordinal_mk :: proc "contextless" (o: Operands) -> Category {
	// one: i % 10 = 1 and i % 100 != 11
	if o.i % 10 == 1 && o.i % 100 != 11 {
		return .One
	}
	// two: i % 10 = 2 and i % 100 != 12
	if o.i % 10 == 2 && o.i % 100 != 12 {
		return .Two
	}
	// many: i % 10 = 7,8 and i % 100 != 17,18
	if (o.i % 10 == 7 || o.i % 10 == 8) && !(o.i % 100 == 17 || o.i % 100 == 18) {
		return .Many
	}
	return .Other
}

// ordinal_mr implements the CLDR ordinal rules for: mr.
@(private = "file")
ordinal_mr :: proc "contextless" (o: Operands) -> Category {
	// one: n = 1
	if (o.t == 0 && o.i == 1) {
		return .One
	}
	// two: n = 2,3
	if (o.t == 0 && (o.i == 2 || o.i == 3)) {
		return .Two
	}
	// few: n = 4
	if (o.t == 0 && o.i == 4) {
		return .Few
	}
	return .Other
}

// ordinal_ne implements the CLDR ordinal rules for: ne.
@(private = "file")
ordinal_ne :: proc "contextless" (o: Operands) -> Category {
	// one: n = 1..4
	if (o.t == 0 && between(o.i, 1, 4)) {
		return .One
	}
	return .Other
}

// ordinal_sq implements the CLDR ordinal rules for: sq.
@(private = "file")
ordinal_sq :: proc "contextless" (o: Operands) -> Category {
	// one: n = 1
	if (o.t == 0 && o.i == 1) {
		return .One
	}
	// many: n % 10 = 4 and n % 100 != 14
	if (o.t == 0 && o.i % 10 == 4) && !(o.t == 0 && o.i % 100 == 14) {
		return .Many
	}
	return .Other
}

// ordinal_sv implements the CLDR ordinal rules for: sv.
@(private = "file")
ordinal_sv :: proc "contextless" (o: Operands) -> Category {
	// one: n % 10 = 1,2 and n % 100 != 11,12
	if (o.t == 0 && (o.i % 10 == 1 || o.i % 10 == 2)) && !(o.t == 0 && (o.i % 100 == 11 || o.i % 100 == 12)) {
		return .One
	}
	return .Other
}

// ordinal_uk implements the CLDR ordinal rules for: uk.
@(private = "file")
ordinal_uk :: proc "contextless" (o: Operands) -> Category {
	// few: n % 10 = 3 and n % 100 != 13
	if (o.t == 0 && o.i % 10 == 3) && !(o.t == 0 && o.i % 100 == 13) {
		return .Few
	}
	return .Other
}

