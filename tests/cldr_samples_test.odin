			{"2.0", .Other}, {"2.1", .Other}, {"2.2", .Other}, {"2.3", .Other}, {"2.4", .Other}, {"2.5", .Other},
			{"2.6", .Other}, {"10.0", .Other}, {"100.0", .Other}, {"1000.0", .Other}, {"10000.0", .Other}, {"100000.0", .Other},
			{"1000000.0", .Other},
		},
	)
}

@(test)
test_cldr_ordinal_zu :: proc(t: ^testing.T) {
	expect_ordinal_samples(
		t,
		"zu",
		{.Other},
		{
			{"0", .Other}, {"1", .Other}, {"2", .Other}, {"3", .Other}, {"4", .Other}, {"5", .Other},
			{"6", .Other}, {"7", .Other}, {"8", .Other}, {"9", .Other}, {"10", .Other}, {"11", .Other},
			{"12", .Other}, {"13", .Other}, {"14", .Other}, {"15", .Other}, {"100", .Other}, {"1000", .Other},
			{"10000", .Other}, {"100000", .Other}, {"1000000", .Other},
		},
	)
}
